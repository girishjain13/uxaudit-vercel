# Neon Postgres (Vercel-native serverless Postgres)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/uxaudit?sslmode=require

# Upstash QStash (queue) — from https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis (dedup + outstanding-page counters)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browserless.io (remote headless Chromium) — or swap for Browserbase
BROWSERLESS_URL=https://chrome.browserless.io
BROWSERLESS_TOKEN=

# Vercel Blob (screenshot storage) — auto-populated when deployed on Vercel;
# for local dev, create a store in the Vercel dashboard and paste the token here
BLOB_READ_WRITE_TOKEN=

# Public base URL this app is reachable at — QStash needs this to call back
# into /api/crawl/page. In production this is your Vercel deployment URL;
# locally, use a tunnel (ngrok, or `vercel dev` with a forwarded URL).
APP_BASE_URL=https://your-app.vercel.app
